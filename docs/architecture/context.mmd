C4Context
    title System Context — Daily AI Podcast

    Person(listener, "Listener", "Daily listener subscribing via RSS")
    System_Ext(player, "Podcast App", "Standard RSS & MP3 podcast player")

    System(podcast, "Podcast System", "Curates Stories, writes a two-Persona Script, synthesizes MP3, publishes RSS Feed")

    System_Ext(sources, "News Sources", "Upstream tech news feeds and discussions (e.g. Hacker News)")
    System_Ext(extractor, "Content Extractor", "URL-to-Markdown article extractor (e.g. Jina Reader)")
    System_Ext(ai, "AI Provider", "LLM inference and multi-speaker TTS (OpenRouter)")

    Rel(listener, player, "Listens with")
