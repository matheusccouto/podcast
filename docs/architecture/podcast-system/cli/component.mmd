C4Component
    title Component Diagram — Podcast CLI (src/podcast/)

    Boundary(upstream, "Upstream APIs") {
        System_Ext(sources, "News Sources", "Stories & comments")
        System_Ext(extractor, "Content Extractor", "Readable article text")
        System_Ext(ai, "AI Provider", "LLM & TTS APIs")
    }

    Container_Boundary(cli, "Podcast CLI (src/podcast/)") {
        Component(entry, "CLI & Core", "__main__.py, settings.py, models.py", "CLI entrypoint, settings, shared HTTP client & domain models")
        Component(ingestion, "Ingestion Adapters", "sources/, fetcher.py", "Source & ContentFetcher protocols and adapters")
        Component(agents, "Editorial Workflow", "agents/", "Workflow orchestrating nested Curator & Writer subagents")
        Component(tts, "Audio Synthesizer", "tts.py", "Multi-speaker TTS synthesis and normalized MP3 encoding")
        Component(publishing, "Feed Publisher", "feed/", "Renders RSS 2.0 template and writes Episode JSON/MP3")
    }

    Boundary(hosting, "GitHub & CI Hosting") {
        Container(pages, "GitHub Pages", "gh-pages", "feed.xml & Episode JSON")
        Container(releases, "GitHub Releases", "CDN assets", "Episode MP3 files")
    }

    Rel(entry, agents, "Runs editorial workflow")
    Rel(agents, ingestion, "Calls via Source & ContentFetcher protocols")
    Rel(ingestion, sources, "Stories & comments", "HTTPS")
    Rel(ingestion, extractor, "Article text", "HTTPS")
    Rel(agents, ai, "LLM inference", "HTTPS")
    Rel(entry, tts, "Synthesizes Script turns")
    Rel(tts, ai, "Multi-speaker PCM audio", "HTTPS")
    Rel(entry, publishing, "Publishes Script + SynthesizedAudio")
    Rel(publishing, pages, "Outputs feed.xml & JSON for Git deploy")
    Rel(publishing, releases, "Outputs Episode MP3 for upload")

    UpdateLayoutConfig($c4ShapeInRow="1", $c4BoundaryInRow="3")
