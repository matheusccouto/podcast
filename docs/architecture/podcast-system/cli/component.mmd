C4Component
    title Component Diagram — Podcast CLI (src/podcast/)

    Boundary(upstream, "Upstream APIs") {
        System_Ext(hn, "Hacker News API", "Firebase JSON")
        System_Ext(jina, "Jina Reader", "r.jina.ai")
        System_Ext(openrouter, "OpenRouter API", "LLM & Fish Audio TTS")
    }

    Container_Boundary(cli, "Podcast CLI (src/podcast/)") {
        Component(entry, "CLI Entrypoint", "__main__.py, settings.py, models.py", "Pydantic Settings CliApp, shared httpx.AsyncClient & frozen domain models")
        Component(ingestion, "Ingestion Adapters", "sources/, fetcher.py", "Source & ContentFetcher protocols (HackerNewsSource, JinaFetcher)")
        Component(agents, "Editorial Workflow", "agents/ (LangGraph + LangChain)", "Module-level podcast_graph orchestrating curator & writer")
        Component(tts, "Audio Synthesizer", "tts.py", "OpenRouterTTS (_request_pcm + _encode_mp3) via ffmpeg loudnorm")
        Component(publishing, "Feed Publisher", "feed.py, feed.xml.j2", "Feed.from_settings renders Jinja2 RSS & writes Episode JSON/MP3")
    }

    Boundary(hosting, "GitHub & CI Hosting") {
        Container(pages, "GitHub Pages", "gh-pages", "feed.xml & episodes/*.json")
        Container(releases, "GitHub Releases", "CDN assets", "episodes/*.mp3")
    }

    Rel(entry, agents, "Invokes podcast_graph.ainvoke(state, context, config)")
    Rel(agents, ingestion, "Calls via Curator ToolRuntime")
    Rel(ingestion, hn, "Stories & comments", "HTTPS")
    Rel(ingestion, jina, "Article Markdown", "HTTPS")
    Rel(agents, openrouter, "ChatOpenRouter completions", "HTTPS")
    Rel(entry, tts, "Synthesizes Script.turns")
    Rel(tts, openrouter, "Fish Audio PCM audio", "HTTPS")
    Rel(entry, publishing, "Publishes Script + SynthesizedAudio")
    Rel(publishing, pages, "Outputs dist/feed.xml & JSON for Git deploy")
    Rel(publishing, releases, "Outputs dist/episodes/*.mp3 for upload")

    UpdateLayoutConfig($c4ShapeInRow="1", $c4BoundaryInRow="3")
