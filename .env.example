# Required for OpenRouter LLM, TTS, Curator (Jev), and JevEval
OPENROUTER_API_KEY=

# Required for Exa article content extraction
EXA_API_KEY=

# Swappable OpenRouter model IDs
CURATOR_MODEL=jev-1.14
LLM_MODEL=baidu/ernie-5.5-flash-preview:free
TTS_MODEL=fish-audio/s2.1-pro-free:free

# Podcast Feed metadata
PODCAST_LANGUAGE=pt-BR
PODCAST_TITLE="HN Daily BR"
PODCAST_DESCRIPTION="Resumo diário de tecnologia e Hacker News."
PODCAST_AUTHOR="Matheus Couto"
PODCAST_BASE_URL=http://localhost:8000
PODCAST_RELEASES_BASE_URL=http://localhost:8000/episodes
PODCAST_DIST_DIR=dist

# Fish Audio reference_id values for the two Personas (required for TTS)
PERSONA_A_VOICE_ID=0ffee1af32254090b3630823baade12b
PERSONA_B_VOICE_ID=0e26d2df0d0848e3b34099bfb55fd6ea
