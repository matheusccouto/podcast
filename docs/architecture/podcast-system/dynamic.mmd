C4Dynamic
    title Dynamic Flow — Daily Episode Run

    Component(cli, "Podcast CLI", "__main__.py")
    Component(graph, "Editorial Workflow", "agents/workflow.py")
    Component(curator, "Curator", "agents/curator/")
    Component(ingestion, "Ingestion", "sources/, fetcher.py")
    Component(writer, "Writer", "agents/writer/")
    Component(tts, "Audio Synthesizer", "tts.py + ffmpeg")
    Component(feed, "Feed Publisher", "feed/")
    Container(releases, "GitHub Releases", "MP3 assets")
    Container(pages, "GitHub Pages", "feed.xml, Feed artwork & Episode JSON")
    System_Ext(player, "Podcast App", "RSS subscriber")

    Rel(cli, graph, "1. Open shared HTTP client & run editorial workflow")
    Rel(graph, curator, "2. Run Jev Curator for previous day")
    Rel(curator, ingestion, "3. Fetch Stories, content & comments")
    Rel(curator, graph, "4. Return ranked Segments & CuratedStories")
    Rel(graph, writer, "5. Pass curated Stories & Persona context")
    Rel(writer, graph, "6. Return validated two-Persona Dialogue")
    Rel(cli, tts, "7. Synthesize PCM & encode loudnorm MP3")
    Rel(cli, feed, "8. Write Episode artifacts & render RSS Feed")
    Rel(feed, releases, "9. Upload Episode MP3 first")
    Rel(feed, pages, "10. Publish updated feed.xml & JSON")
    Rel(player, pages, "11. Poll feed.xml")
    Rel(player, releases, "12. Stream Episode MP3")
