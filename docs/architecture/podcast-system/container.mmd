C4Container
    title Container Diagram — Podcast System

    Boundary(consumers, "Listener Side") {
        Person(listener, "Listener", "Daily listener")
        System_Ext(player, "Podcast App", "RSS player")
    }

    System_Boundary(podcast, "Podcast System") {
        Container(cli, "Podcast CLI", "Python CLI / GitHub Actions", "Runs curation, scriptwriting, TTS synthesis & Feed publishing")
        Container(pages, "GitHub Pages", "gh-pages static hosting", "Hosts feed.xml, Feed artwork & Episode metadata JSON")
        Container(releases, "GitHub Releases", "GitHub CDN assets", "Hosts Episode MP3 audio files")
    }

    Boundary(providers, "Upstream APIs") {
        System_Ext(sources, "News Sources", "Upstream Story & comment feeds")
        System_Ext(extractor, "Content Extractor", "Readable article extraction")
        System_Ext(ai, "AI Provider", "LLM & TTS APIs")
    }

    Rel(listener, player, "Uses")
    Rel(player, pages, "Polls feed.xml", "HTTPS")
    Rel(player, releases, "Streams MP3", "HTTPS")

    Rel(cli, pages, "Deploys feed.xml, Feed artwork & Episode JSON", "Git")
    Rel(cli, releases, "Uploads Episode MP3", "HTTPS")
    Rel(cli, sources, "Fetches Stories & comments", "HTTPS")
    Rel(cli, extractor, "Extracts article text", "HTTPS")
    Rel(cli, ai, "Runs LLM agents & TTS", "HTTPS")

    UpdateRelStyle(listener, player, $offsetX="15")
    UpdateRelStyle(player, pages, $offsetY="-20")
    UpdateRelStyle(player, releases, $offsetY="15")
    UpdateRelStyle(cli, pages, $offsetX="-55")
    UpdateRelStyle(cli, releases, $offsetX="30")
    UpdateRelStyle(cli, sources, $offsetY="-20")
    UpdateRelStyle(cli, extractor, $offsetY="-5")
    UpdateRelStyle(cli, ai, $offsetY="15")
    UpdateLayoutConfig($c4ShapeInRow="1", $c4BoundaryInRow="3")
