C4Component
    title Component Diagram — Editorial Agents (src/podcast/agents/)

    Container_Boundary(workflow, "src/podcast/agents/") {
        Component(graph, "Editorial Graph", "workflow.py", "Orchestrates curation -> scriptwriting flow")
        Component(curator, "Curator Subagent", "curator/", "Curates Stories using Taste Profile and grounding validation")
        Component(writer, "Writer Subagent", "writer/", "Writes two-Persona Dialogue with voice validation")
        Component(model, "Chat Model", "model.py", "Runtime-configurable LLM binding")
    }

    Component(sources, "Ingestion Protocols", "Source & ContentFetcher", "Injected per run into workflow and Curator")
    System_Ext(ai, "AI Provider", "LLM API")

    Rel(graph, curator, "Curates candidate Stories")
    Rel(graph, writer, "Writes Script Dialogue")
    Rel(curator, model, "Structured ResearchBrief output")
    Rel(writer, model, "Structured Dialogue output")
    Rel(curator, sources, "Fetches Stories, content & comments")
    Rel(model, ai, "LLM inference", "HTTPS")

    UpdateLayoutConfig($c4ShapeInRow="2", $c4BoundaryInRow="1")
