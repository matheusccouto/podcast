# Required for OpenRouter LLM, TTS, Curator (Jev), and JevEval
OPENROUTER_API_KEY=

# Required for Exa article content extraction
EXA_API_KEY=

# Swappable OpenRouter model IDs (defaults live in src/podcast/settings.py;
# leave a value blank to take the default)
CURATOR_MODEL=jev-1.14
LLM_MODEL=deepseek/deepseek-v4.1-flash
TTS_MODEL=google/gemini-3.8-flash-tts
COVER_MODEL=

# Master cover artwork used as the per-Episode style reference (default: static/cover.jpg)
PODCAST_MASTER_COVER_PATH=

# Podcast Feed metadata
PODCAST_LANGUAGE=pt-BR
PODCAST_TITLE="HN Daily BR"
PODCAST_DESCRIPTION="Resumo diário de tecnologia e Hacker News."
PODCAST_AUTHOR="Matheus Couto"
PODCAST_BASE_URL=http://localhost:8000
PODCAST_RELEASES_BASE_URL=http://localhost:8000/episodes
PODCAST_DIST_DIR=dist

# OpenRouter TTS voice identifiers for the two Personas
PERSONA_A_VOICE_ID=Charon
PERSONA_B_VOICE_ID=Aoede
